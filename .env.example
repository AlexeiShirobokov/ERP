# Конфигурация ERP. Скопируйте в .env (он в .gitignore) — файл читается
# автоматически и на сервере, и при локальном запуске.
#
#   cp .env.example .env   и впишите свой ключ OpenRouter
#
# После изменения .env на сервере перезапустите Django-процесс (gunicorn/uwsgi).

# 0 на проде, 1 локально
DJANGO_DEBUG=0

# --- Распознавание паспорта БВР (vision через OpenRouter) ---
BVR_VISION_ENABLED=1
# Ключ OpenRouter (https://openrouter.ai/settings/keys). НЕ коммитить!
BVR_VISION_API_KEY=sk-or-ваш_ключ

# Необязательно (значения по умолчанию):
# BVR_VISION_MODEL=anthropic/claude-sonnet-4.6
# BVR_VISION_MODEL_LOCATE=anthropic/claude-haiku-4.5
# BVR_VISION_MODEL_ESCALATE=anthropic/claude-opus-4.7
# BVR_VISION_TWO_PASS=1
# BVR_VISION_PROXY=
# BVR_VISION_MAX_PDF_MB=20
