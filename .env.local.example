# Локальные настройки для запуска БВР (скопируйте в .env.local — он в .gitignore).
# Ключ OpenRouter обязателен ТОЛЬКО для распознавания паспорта.
# Без него форма работает, но зарядную карту нужно вводить вручную.

BVR_VISION_ENABLED=1
BVR_VISION_API_KEY=sk-or-ваш_ключ
# Необязательно (значения по умолчанию):
# BVR_VISION_MODEL=anthropic/claude-sonnet-4.6
# BVR_VISION_MODEL_LOCATE=anthropic/claude-haiku-4.5
# BVR_VISION_MODEL_ESCALATE=anthropic/claude-opus-4.7
# BVR_VISION_TWO_PASS=1
